# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
# Get your connection string from neon.tech
# Example: postgresql://neondb_owner:npg_xxxx@ep-soft-voice-a50eey3k.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_PIN=8888

# Make.com Integration Webhook
# Paste your Make.com custom webhook URL here
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-custom-webhook-url

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60
