# Server Configuration
PORT=5000
NODE_ENV=development

# Make.com Integration Webhook
# Paste your Make.com custom webhook URL here
# Example: https://hook.eu1.make.com/abcdef1234567890
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-custom-webhook-url

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
